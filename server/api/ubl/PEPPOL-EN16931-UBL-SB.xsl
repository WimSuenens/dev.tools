   <xsl:template match="//*[not(*) and not(normalize-space())]"
                 priority="42"
                 mode="d8e205">
      <xsl:param name="schxslt:patterns-matched" as="xs:string*"/>
      <xsl:choose>
         <xsl:when test="$schxslt:patterns-matched[. = 'd8e205']">
            <schxslt:rule pattern="d8e205">
